{
  // Configuración de despliegue en Cloudflare Workers.
  // Build: `bun run build` -> genera dist/client (estáticos) y dist/server (SSR).
  // Deploy: `npm run deploy` (equivale a `vite build && wrangler deploy --autoconfig=false`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "joinfamilyhelpw",
  "main": "./dist/server/index.mjs",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
